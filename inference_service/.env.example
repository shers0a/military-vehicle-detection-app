# Path to the trained YOLOv8 weights file. If unset, the service searches
# (in order): ./best.pt, ../best.pt, ../runs/detect/rezultat_militar/weights/best.pt
MODEL_PATH=

# "auto" picks cuda:0 if available, otherwise cpu. Override with "cpu" or "cuda:0".
DEVICE=auto

DEFAULT_CONFIDENCE_THRESHOLD=0.35
DEFAULT_SLICE_SIZE=640
DEFAULT_OVERLAP_RATIO=0.2
DEFAULT_GSD_M_PER_PX=0.3
DEFAULT_GRID_SIZE_M=50.0
