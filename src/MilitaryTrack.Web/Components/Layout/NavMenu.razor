@attribute [StreamRendering]
@inject InferenceClient Inference

<div class="model-status">
    @switch (_state)
    {
        case ServiceState.Checking:
            <span class="badge badge-neutral">Checking model…</span>
            break;
        case ServiceState.Ok:
            <span class="badge badge-ok" title="Running on @_health?.Device">Model loaded</span>
            break;
        case ServiceState.Degraded:
            <span class="badge badge-bad" title="@_health?.Detail">Model not loaded</span>
            break;
        default:
            <span class="badge badge-neutral" title="The inference service did not respond">Service offline</span>
            break;
    }
</div>

<div class="nav-menu">
    <NavLink href="detect" Match="NavLinkMatch.All" class="nav-link">
        Object Detection <span class="nav-sub">(Single Image)</span>
    </NavLink>
    <NavLink href="tactical-map" class="nav-link">
        Tactical Map <span class="nav-sub">(T0 vs T1)</span>
    </NavLink>
</div>

<style>
    .nav-menu {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .nav-link {
        display: block;
        padding: 0.6rem 0.75rem;
        border-radius: 6px;
        color: #c7ccd6;
        text-decoration: none;
    }

    .nav-link:hover {
        background: #29344326;
        background: #2a3547;
        color: #fff;
    }

    .nav-link.active {
        background: #3a5a8c;
        color: #fff;
    }

    .nav-sub {
        display: block;
        font-size: 0.75rem;
        opacity: 0.7;
    }

    .model-status {
        margin-bottom: 1rem;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .badge::before {
        content: "";
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: currentColor;
    }

    .badge-ok {
        background: #1e4d33;
        color: #6ee7a0;
    }

    .badge-bad {
        background: #4d1e1e;
        color: #f28b8b;
    }

    .badge-neutral {
        background: #333b48;
        color: #aab1bd;
    }
</style>

@code {
    // The layout is statically rendered, so this runs on every page load. A short timeout
    // keeps a busy inference service from stalling the page (the client default is 300s).
    private static readonly TimeSpan HealthCheckTimeout = TimeSpan.FromSeconds(3);

    private enum ServiceState { Checking, Ok, Degraded, Offline }

    private ServiceState _state = ServiceState.Checking;
    private HealthStatus? _health;

    protected override async Task OnInitializedAsync()
    {
        using var cts = new CancellationTokenSource(HealthCheckTimeout);
        try
        {
            _health = await Inference.GetHealthAsync(cts.Token);
            _state = _health.ModelLoaded ? ServiceState.Ok : ServiceState.Degraded;
        }
        catch (Exception)
        {
            _state = ServiceState.Offline;
        }
    }
}
