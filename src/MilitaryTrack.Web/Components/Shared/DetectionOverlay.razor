@* Renders detection bounding boxes as an SVG layer on top of the source image,
   scaled via viewBox so it stays aligned regardless of the rendered display size. *@

<div class="overlay-container">
    <img src="@ImageDataUrl" alt="Detection source" class="overlay-image" />
    <svg class="overlay-svg" viewBox="0 0 @ImageWidth @ImageHeight" preserveAspectRatio="xMidYMid meet">
        @foreach (var d in Detections)
        {
            var x = d.Bbox[0];
            var y = d.Bbox[1];
            var w = d.Bbox[2] - d.Bbox[0];
            var h = d.Bbox[3] - d.Bbox[1];
            var color = ColorFor(d.ClassName);
            var fontSize = System.Math.Max(ImageWidth, ImageHeight) / 90.0;

            <rect x="@x.ToString(Ci)" y="@y.ToString(Ci)" width="@w.ToString(Ci)" height="@h.ToString(Ci)"
                  fill="none" stroke="@color" stroke-width="@((System.Math.Max(ImageWidth, ImageHeight) / 500.0).ToString(Ci))" />
            @((MarkupString)TextLabelMarkup(x, y - 4, color, fontSize, $"{d.ClassName} ({d.Confidence:P0})"))
        }
    </svg>
</div>

<style>
    .overlay-container {
        position: relative;
        display: inline-block;
        max-width: 100%;
    }

    .overlay-image {
        display: block;
        max-width: 100%;
        height: auto;
    }

    .overlay-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }
</style>

@code {
    private static readonly System.Globalization.CultureInfo Ci = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter, EditorRequired]
    public string ImageDataUrl { get; set; } = "";

    [Parameter, EditorRequired]
    public int ImageWidth { get; set; }

    [Parameter, EditorRequired]
    public int ImageHeight { get; set; }

    [Parameter, EditorRequired]
    public List<Detection> Detections { get; set; } = [];

    private static readonly string[] Palette =
    [
        "#e74c3c", "#3498db", "#2ecc71", "#f1c40f", "#9b59b6", "#e67e22"
    ];

    private static readonly Dictionary<string, string> ColorByClass = new();

    private static string ColorFor(string className)
    {
        if (!ColorByClass.TryGetValue(className, out var color))
        {
            color = Palette[ColorByClass.Count % Palette.Length];
            ColorByClass[className] = color;
        }
        return color;
    }

    private static string TextLabelMarkup(double x, double y, string color, double fontSize, string text)
    {
        var escaped = System.Net.WebUtility.HtmlEncode(text);
        return $"<text x=\"{x.ToString(Ci)}\" y=\"{y.ToString(Ci)}\" fill=\"{color}\" font-size=\"{fontSize.ToString(Ci)}\" font-family=\"sans-serif\">{escaped}</text>";
    }
}
