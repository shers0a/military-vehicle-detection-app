@page "/tactical-map"
@inject InferenceClient InferenceClient
@rendermode InteractiveServer

<PageTitle>Tactical Map</PageTitle>

<h1>Tactical Map &amp; Density Analysis</h1>
<p class="banner banner-info">Analyzes movement and calculates vehicle density per hectare.</p>

<div class="two-col">
    <UploadPanel Label="Image T0 (Previous)" ImageChanged="img => OnImageChanged(0, img)" />
    <UploadPanel Label="Image T1 (Current)" ImageChanged="img => OnImageChanged(1, img)" />
</div>

<div class="controls">
    <button class="btn-primary" disabled="@(!CanGenerate || _busy)" @onclick="GenerateAsync">
        @(_busy ? "Calculating…" : "Generate Tactical Map")
    </button>
</div>

@if (_error is not null)
{
    <p class="banner banner-error">@_error</p>
}

@if (_result is not null)
{
    @foreach (var w in _result.Warnings)
    {
        <p class="banner banner-warning">@w</p>
    }

    <hr />
    <h3>Density Report (Moment T1)</h3>
    <div class="metrics">
        <div class="metric"><div class="metric-value">@_result.PointsT1Count</div><div class="metric-label">Vehicles Detected</div></div>
        <div class="metric"><div class="metric-value">@($"{_result.TotalAreaHa:F2} ha")</div><div class="metric-label">Analyzed Area</div></div>
        <div class="metric"><div class="metric-value">@($"{_result.DensityT1VehPerHa:F2}")</div><div class="metric-label">Avg Density (veh/ha)</div></div>
    </div>

    <p>Tactical Grid Resolution: @(_result.BinsX)x@(_result.BinsY) sectors</p>
    <DivergingHeatmap Matrix="_result.DiffMatrix" BinsX="_result.BinsX" BinsY="_result.BinsY" />
    <p class="hint">Movement Heatmap — Red = Arrival, Blue = Departure</p>
}

<style>
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .controls { margin: 1rem 0; }
    .btn-primary { padding: 0.5rem 1rem; cursor: pointer; }
    .banner { padding: 0.6rem 1rem; border-radius: 6px; margin: 0.75rem 0; }
    .banner-error { background: #fdecea; color: #b32121; }
    .banner-info { background: #e8f0fb; color: #1c4e8a; }
    .banner-warning { background: #fff8e1; color: #8a6d00; }
    .metrics { display: flex; gap: 2rem; margin: 1rem 0; }
    .metric-value { font-size: 1.6rem; font-weight: 700; }
    .metric-label { font-size: 0.8rem; opacity: 0.7; }
    .hint { font-size: 0.85rem; opacity: 0.7; }
</style>

@code {
    private UploadedImage? _imageT0;
    private UploadedImage? _imageT1;
    private TacticalMapResult? _result;
    private bool _busy;
    private string? _error;

    private bool CanGenerate => _imageT0 is not null && _imageT1 is not null;

    private void OnImageChanged(int index, UploadedImage? image)
    {
        if (index == 0) _imageT0 = image; else _imageT1 = image;
        _result = null;
        _error = null;
    }

    private async Task GenerateAsync()
    {
        if (_imageT0 is null || _imageT1 is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _result = null;

        try
        {
            using var streamT0 = _imageT0.OpenStream();
            using var streamT1 = _imageT1.OpenStream();
            _result = await InferenceClient.GetTacticalMapAsync(streamT0, _imageT0.FileName, streamT1, _imageT1.FileName);
        }
        catch (InferenceServiceException ex)
        {
            _error = $"Tactical map generation failed: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the inference service: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
